#!/bin/zsh
set -e

RALPH_HOME="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
source "$RALPH_HOME/lib/ralph-core.sh"
ralph_init

RALPH_VERSION="1.0.0"

usage() {
  cat <<EOF
ralph — Autonomous agent ecosystem for backlog-driven SDLC

Usage: ralph <command> [options]

Agent commands (Jira-driven):
  planner           Run the Planner agent (AFK loop by default)
  implementer       Run the Implementer agent
  reviewer          Run the Reviewer agent
  tester            Run the Tester agent
  refactor          Run the Refactorer agent
  documenter        Run the Documenter agent

GitHub commands:
  fixer             Run the Fixer agent (responds to PR review feedback)
  merger            Run the Merger agent (auto-merges approved PRs)

Direct invocation:
  run <agent> <key> Run an agent on a specific task, bypassing backlog query
                    e.g. ralph run planner PRODUCT-711

Agent options:
  <N>               Run exactly N iterations, then exit (e.g. ralph planner 10)
  --once            Run a single iteration, then exit (shorthand for 1)
  --afk             Run in AFK loop mode (default)

Debugging:
  debug <agent> [N] Tail a running agent's output (default: instance 1)
    -f, --follow    Live tail (like tail -f)
    -n, --lines N   Number of lines to show (default: 200)
    --raw           Show raw JSON instead of rendered text
    --prompt        Show last iteration's full prompt (system + initial message)
    --preview-prompt Assemble system prompt on-the-fly (no iteration needed)
    --last N        Show last N saved iterations (requires RALPH_LOG_DIR)
    --analyze       Analyze last N iterations for bottlenecks and waste (use with --last)

Utility commands:
  validate          Run routing validation (accepts --matrix, --check-prompts, --check-loops, --check-all)
  test              Run unit tests (tests/)
  status            Show task counts and running instances for all agents
  cleanup           Remove orphan processes, stale slots, and orphan worktrees
    --dry-run       Show what would be cleaned without acting
  init              Create a .ralphrc file in the current directory
  config            Show current configuration
  version           Show version
  watchdog          Analyze agent session logs for patterns and anti-patterns
    --since <dur>   Only analyze logs from last duration (e.g. 2h, 30m, 1d)
    --agent <name>  Filter to one agent type
    --apply         Auto-append suggested rules to target project's CLAUDE.md
  help              Show this help message
EOF
}

cmd_init() {
  if [[ -f ".ralphrc" ]]; then
    echo ".ralphrc already exists in this directory."
    exit 1
  fi
  cp "$RALPH_HOME/.ralphrc.example" ".ralphrc"
  echo "Created .ralphrc — edit it with your provider credentials."

  if [[ ! -f ".mcp.json" ]]; then
    cat > ".mcp.json" <<'MCPEOF'
{
  "mcpServers": {
    "jira": {
      "command": "ralph-jira-mcp"
    }
  }
}
MCPEOF
    echo "Created .mcp.json — Jira MCP server configured."
  fi
}

cmd_config() {
  source "$RALPH_HOME/lib/ralph-core.sh"
  local agent_cli
  agent_cli=$(ralph_get_agent_cli)

  echo "RALPH_HOME:           $RALPH_HOME"
  echo "RALPH_PROVIDER:       $RALPH_PROVIDER"
  echo "RALPH_MODEL_PROVIDER: $RALPH_MODEL_PROVIDER (cli: $agent_cli)"
  echo "RALPH_VERSION:        $RALPH_VERSION"
  echo ""
  echo "Provider:       $RALPH_HOME/lib/providers/$RALPH_PROVIDER.sh"
  echo "Instructions:   $RALPH_HOME/providers/$RALPH_PROVIDER/instructions.md"
  echo "Routing:        $RALPH_HOME/providers/$RALPH_PROVIDER/routing.json"
  echo "Prompts:        $RALPH_HOME/prompts/"
  echo ""

  if [[ -f ".ralphrc" ]]; then
    echo "Local config:   $(pwd)/.ralphrc"
  else
    echo "Local config:   (none — run 'ralph init' to create .ralphrc)"
  fi
}

cmd_status() {
  ralph_load_provider

  local routing_json
  routing_json="$(ralph_get_routing_json)"

  # Jira-gated agents from routing.json
  local jira_agents=()
  while IFS= read -r a; do
    jira_agents+=("$a")
  done < <(jq -r '.agents | keys[]' "$routing_json")

  # GitHub-gated agents (not in routing.json)
  local github_agents=(fixer merger)

  # All agents in display order
  local all_agents=("${jira_agents[@]}" "${github_agents[@]}")

  # ── Gather Jira task counts ──────────────────────────────────────────────
  typeset -A task_counts
  ralph_validate_env $PROVIDER_ENV_VARS
  local query
  for agent in "${jira_agents[@]}"; do
    query="$(ralph_get_query "$agent")"
    task_counts[$agent]=$(provider_check_tasks "$query")
  done

  # ── Gather GitHub PR counts ─────────────────────────────────────────────
  source "$RALPH_HOME/lib/ralph-github-loop.sh"
  if command -v gh &>/dev/null && gh auth status &>/dev/null; then
    task_counts[fixer]=$(ralph_fetch_fixer_prs | jq 'length')
    task_counts[merger]=$(ralph_fetch_mergeable_prs | jq 'length')
  else
    task_counts[fixer]="?"
    task_counts[merger]="?"
  fi

  # ── Count running instances per agent ───────────────────────────────────
  typeset -A running_counts
  local count base_dir
  for agent in "${all_agents[@]}"; do
    count=0
    base_dir="/tmp/ralph-${agent}"
    if [[ -d "$base_dir" ]]; then
      for pidfile in "$base_dir"/*/pid(N); do
        if kill -0 "$(cat "$pidfile")" 2>/dev/null; then
          count=$((count + 1))
        else
          # Clean stale slot
          rm -rf "${pidfile:h}" 2>/dev/null
        fi
      done
    fi
    running_counts[$agent]=$count
  done

  # ── Print table ─────────────────────────────────────────────────────────
  local total_tasks=0 total_running=0

  printf "%-14s %5s  %7s\n" "Agent" "Tasks" "Running"
  printf "%.0s─" {1..30}; echo

  local t r
  for agent in "${all_agents[@]}"; do
    t="${task_counts[$agent]:-0}"
    r="${running_counts[$agent]:-0}"
    printf "%-14s %5s  %7s\n" "$agent" "$t" "$r"
    [[ "$t" =~ ^[0-9]+$ ]] && total_tasks=$((total_tasks + t))
    total_running=$((total_running + r))
  done

  printf "%.0s─" {1..30}; echo
  printf "%-14s %5s  %7s\n" "Total" "$total_tasks" "$total_running"
}

cmd_cleanup() {
  local dry_run=false
  [[ "${1:-}" == "--dry-run" ]] && dry_run=true
  local found=false

  # 1. Find & kill orphan agent processes, clean stale slots
  for agent_dir in /tmp/ralph-*/; do
    [[ "$agent_dir" == "/tmp/ralph-worktrees/" ]] && continue
    [[ -d "$agent_dir" ]] || continue
    for pidfile in "$agent_dir"*/pid(N); do
      local pid=$(<"$pidfile")
      local slot_dir="${pidfile:h}"
      if ! kill -0 "$pid" 2>/dev/null; then
        echo "Stale slot: $slot_dir (PID $pid dead)"
        found=true
        $dry_run || rm -rf "$slot_dir"
      fi
    done
  done

  # 2. Kill processes referencing orphan worktrees, then remove them
  for wt in /tmp/ralph-worktrees/*(N/); do
    local agent_instance="${wt:t}"
    local agent="${agent_instance%-*}"
    local inst="${agent_instance##*-}"
    local slot="/tmp/ralph-$agent/$inst/pid"
    if [[ ! -f "$slot" ]] || ! kill -0 "$(<"$slot")" 2>/dev/null; then
      echo "Orphan worktree: $wt"
      found=true
      if ! $dry_run; then
        ralph_cleanup_worktree_processes "$wt"
        ralph_cleanup_worktree "$wt"
      fi
    fi
  done

  # 3. Clean stale work files
  for wf in /tmp/ralph-*-work.json(N); do
    local base="${wf:t}"
    base="${base%-work.json}"
    base="${base#ralph-}"
    local agent="${base%-*}"
    local inst="${base##*-}"
    local slot="/tmp/ralph-$agent/$inst/pid"
    if [[ ! -f "$slot" ]] || ! kill -0 "$(<"$slot")" 2>/dev/null; then
      echo "Stale work file: $wf"
      found=true
      $dry_run || rm -f "$wf"
    fi
  done

  # 4. git worktree prune
  $dry_run || git worktree prune 2>/dev/null || true

  $found || echo "Nothing to clean."
  echo "Cleanup complete."
}

cmd_version() {
  echo "ralph $RALPH_VERSION"
}

cmd_test() {
  local test_dir="$RALPH_HOME/tests"
  local failures=0
  local count=0
  for t in "$test_dir"/test-*.sh; do
    [[ -f "$t" ]] || continue
    count=$((count + 1))
    echo "▶ $(basename "$t")"
    if zsh "$t"; then
      :
    else
      failures=$((failures + 1))
    fi
    echo ""
  done
  if (( count == 0 )); then
    echo "No tests found in $test_dir"
    exit 1
  fi
  if (( failures > 0 )); then
    echo "FAILED: $failures/$count test file(s) had failures"
    exit 1
  fi
  echo "ALL $count test file(s) passed"
}

# Agent key → display name mapping
agent_display_name() {
  case "$1" in
    planner)      echo "Planner" ;;
    implementer)  echo "Implementer" ;;
    reviewer)     echo "Reviewer" ;;
    tester)       echo "Tester" ;;
    refactor)     echo "Refactorer" ;;
    documenter)   echo "Documenter" ;;
    fixer)        echo "Fixer" ;;
    merger)       echo "Merger" ;;
  esac
}

cmd_run() {
  local agent_key="${1:-}"
  local task_key="${2:-}"

  if [[ -z "$agent_key" || -z "$task_key" ]]; then
    echo "Usage: ralph run <agent> <task-key>"
    echo "  e.g. ralph run planner PRODUCT-711"
    echo "       ralph run implementer https://hihank.atlassian.net/browse/PRODUCT-711"
    exit 1
  fi

  # Validate agent name
  local agent_name
  agent_name=$(agent_display_name "$agent_key")
  if [[ -z "$agent_name" ]]; then
    echo "Unknown agent: $agent_key"
    exit 1
  fi

  # Accept full Jira URL or bare key
  if [[ "$task_key" == http* ]]; then
    task_key="${task_key##*/}"
  fi

  # Load provider
  ralph_load_provider
  ralph_validate_env $PROVIDER_ENV_VARS

  # Fetch the specific task
  local task_file
  task_file=$(mktemp)
  local work_file
  work_file=$(mktemp)
  provider_fetch_tasks "key = \"$task_key\"" 1 > "$work_file"

  local task_count
  task_count=$(jq '.issues | length' "$work_file")
  if (( task_count == 0 )); then
    ralph_error "Task $task_key not found in Jira."
    rm -f "$task_file" "$work_file"
    exit 1
  fi
  jq '.issues[0]' "$work_file" > "$task_file"
  rm -f "$work_file"

  # Build system prompt
  local prompt_file provider_instructions
  prompt_file="$(ralph_get_prompt "$agent_key")"
  provider_instructions="$(ralph_get_provider_instructions)"

  if [[ ! -f "$prompt_file" ]]; then
    ralph_error "Prompt not found: $prompt_file"
    rm -f "$task_file"
    exit 1
  fi

  local full_system_prompt
  full_system_prompt="$(cat "$prompt_file")"
  if [[ -f "$provider_instructions" ]]; then
    full_system_prompt="$full_system_prompt

$(cat "$provider_instructions")"
  fi

  # Append learnings if available
  local learnings_file
  learnings_file=$(ralph_get_learnings_file "$agent_key")
  if [[ -f "$learnings_file" && -s "$learnings_file" ]]; then
    full_system_prompt="$full_system_prompt

# LEARNINGS FROM PAST ITERATIONS
$(cat "$learnings_file")"
  fi

  # Build initial message with task context
  local task_kb
  task_kb=$(provider_render_kb "$task_file")
  rm -f "$task_file"

  local initial_message="You are RALPH_${(U)agent_key} (interactive). Your working directory is: $(pwd).

$task_kb

Execute your workflow now. Start with Step 1."

  # Resolve model
  local model
  model=$(ralph_resolve_model "$agent_key")
  ralph_log "Running $agent_name on $task_key (model: $model, interactive)"

  # Launch Claude interactively (no --print, no stream-json)
  exec claude \
    --verbose \
    --model "$model" \
    --max-turns 100 \
    --dangerously-skip-permissions \
    --append-system-prompt "$full_system_prompt" \
    "$initial_message"
}

cmd_agent() {
  local agent_key="$1"
  shift
  local agent_name
  agent_name=$(agent_display_name "$agent_key")

  # Parse --once / --afk / <N>
  local max_iterations=0  # 0 = unlimited (AFK mode)
  for arg in "$@"; do
    case "$arg" in
      --once) max_iterations=1 ;;
      --afk)  max_iterations=0 ;;
      [0-9]*) max_iterations="$arg" ;;
      *)
        echo "Unknown option for '$agent_key': $arg"
        echo "Usage: ralph $agent_key [--once|--afk|<N>]"
        exit 1
        ;;
    esac
  done

  source "$RALPH_HOME/lib/ralph-gated-loop.sh"
  ralph_gated_loop "$agent_key" "$agent_name" "$max_iterations"
}

cmd_github_agent() {
  local agent_key="$1"
  shift
  local agent_name
  agent_name=$(agent_display_name "$agent_key")

  # Parse --once / --afk / <N>
  local max_iterations=0  # 0 = unlimited (AFK mode)
  for arg in "$@"; do
    case "$arg" in
      --once) max_iterations=1 ;;
      --afk)  max_iterations=0 ;;
      [0-9]*) max_iterations="$arg" ;;
      *)
        echo "Unknown option for '$agent_key': $arg"
        echo "Usage: ralph $agent_key [--once|--afk|<N>]"
        exit 1
        ;;
    esac
  done

  source "$RALPH_HOME/lib/ralph-github-loop.sh"
  ralph_github_loop "$agent_key" "$agent_name" "$max_iterations"
}

cmd_debug() {
  # Parse args: ralph debug <agent> [instance] [-f|--follow] [-n|--lines N] [--raw] [--last N] [--analyze]
  local agent_key="" instance_num=1 follow=false raw=false prompt=false preview_prompt=false lines=200
  local last_n=0 analyze=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=true; shift ;;
      --raw) raw=true; shift ;;
      --prompt) prompt=true; shift ;;
      --preview-prompt) preview_prompt=true; shift ;;
      -n|--lines) lines="$2"; shift 2 ;;
      --last) last_n="$2"; shift 2 ;;
      --analyze) analyze=true; shift ;;
      -*)
        echo "Unknown option: $1"
        echo "Usage: ralph debug <agent> [instance] [-f|--follow] [-n|--lines N] [--raw] [--prompt] [--preview-prompt] [--last N] [--analyze]"
        exit 1
        ;;
      *)
        if [[ -z "$agent_key" ]]; then
          agent_key="$1"
        else
          instance_num="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$agent_key" ]]; then
    echo "Usage: ralph debug <agent> [instance] [-f|--follow] [-n|--lines N] [--raw]"
    echo ""
    echo "Agents: planner, implementer, reviewer, tester, refactor, documenter, fixer, merger"
    exit 1
  fi

  # Validate agent name
  case "$agent_key" in
    planner|implementer|reviewer|tester|refactor|documenter|fixer|merger) ;;
    *)
      echo "Unknown agent: $agent_key"
      echo "Agents: planner, implementer, reviewer, tester, refactor, documenter, fixer, merger"
      exit 1
      ;;
  esac

  source "$RALPH_HOME/lib/ralph-core.sh"

  # --last N mode: show/analyze the last N saved session logs
  if (( last_n > 0 )); then
    if [[ -z "${RALPH_LOG_DIR:-}" ]]; then
      echo "Error: RALPH_LOG_DIR is not set. Add it to your .ralphrc to persist logs."
      exit 1
    fi

    local log_dir="${RALPH_LOG_DIR%/}/${agent_key}-${instance_num}"
    if [[ ! -d "$log_dir" ]]; then
      echo "No saved logs for ${agent_key} #${instance_num} in $log_dir"
      exit 1
    fi

    # Collect the last N log files (newest first)
    local -a log_files
    log_files=( $(ls -t "$log_dir"/*.log 2>/dev/null | head -n "$last_n") )

    if [[ ${#log_files[@]} -eq 0 ]]; then
      echo "No log files found in $log_dir"
      exit 1
    fi

    echo "── ${agent_key} #${instance_num} — last ${#log_files[@]} iteration(s) ──"
    echo ""

    if [[ "$analyze" == "true" ]]; then
      # Concatenate logs with session markers for analysis
      local collected
      collected=$(mktemp /tmp/ralph-debug-analyze.XXXXXX)
      # Process in chronological order (oldest first)
      for log_file in "${(Oa)log_files[@]}"; do
        echo "--- SESSION: $(basename "$log_file") ---" >> "$collected"
        cat "$log_file" >> "$collected"
        echo "" >> "$collected"
      done

      # Truncate if too large (keep last 200K chars)
      local max_chars=200000
      local file_size
      file_size=$(wc -c < "$collected")
      if (( file_size > max_chars )); then
        echo "Warning: Logs exceed ${max_chars} chars, truncating to most recent sessions." >&2
        local truncated
        truncated=$(mktemp /tmp/ralph-debug-trunc.XXXXXX)
        tail -c "$max_chars" "$collected" > "$truncated"
        mv "$truncated" "$collected"
      fi

      local model
      model=$(ralph_resolve_model "watchdog")
      local cli
      cli=$(ralph_get_agent_cli)
      local prompt_file="$RALPH_HOME/prompts/debug-analyze.md"

      echo "Analyzing ${#log_files[@]} iteration(s) (model: $model)..." >&2

      local tmpfile
      tmpfile=$(mktemp /tmp/ralph-debug-output.XXXXXX)
      local log_content
      log_content=$(<"$collected")

      "$cli" --verbose --print --max-turns 50 --output-format stream-json \
        --model "$model" \
        --dangerously-skip-permissions \
        --append-system-prompt "$(cat "$prompt_file")" \
        "Analyze these ${agent_key} agent session logs (${#log_files[@]} iterations, instance #${instance_num}):

$log_content" \
        2>/dev/null \
        | grep --line-buffered '^{' \
        | tee "$tmpfile" \
        | jq -rj 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text // empty' 2>/dev/null

      # Extract and save report
      local output
      output=$(grep '^{' "$tmpfile" \
        | jq -rj 'select(.type == "result") | .result // empty' 2>/dev/null)
      if [[ -z "$output" ]]; then
        output=$(grep '^{' "$tmpfile" \
          | jq -rj 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text // empty' 2>/dev/null)
      fi

      local timestamp
      timestamp=$(date +%Y%m%d-%H%M%S)
      local report_file="$RALPH_LOG_DIR/debug-analysis-${agent_key}-${timestamp}.md"
      local report
      report=$(echo "$output" | sed -n '/<report>/,/<\/report>/p' | sed '1d;$d')
      if [[ -n "$report" ]]; then
        echo "$report" > "$report_file"
      else
        echo "$output" > "$report_file"
      fi
      echo "" >&2
      echo "Report saved: $report_file" >&2

      rm -f "$tmpfile" "$collected"
    else
      # Display mode: render each log with session boundaries
      ralph_get_jq_filters
      local stream_text="$RALPH_STREAM_FILTER"

      # Process in chronological order (oldest first)
      for log_file in "${(Oa)log_files[@]}"; do
        echo "--- SESSION: $(basename "$log_file") ---"
        if [[ "$raw" == "true" ]]; then
          cat "$log_file"
        else
          grep '^{' "$log_file" \
            | jq -rj "$stream_text" 2>/dev/null || true
        fi
        echo ""
      done | if (( lines > 0 )); then tail -n "$lines"; else cat; fi
    fi
    return
  fi

  # --analyze without --last is an error
  if [[ "$analyze" == "true" ]]; then
    echo "Error: --analyze requires --last N (e.g. ralph debug implementer --last 10 --analyze)"
    exit 1
  fi

  # --preview-prompt mode: fetch real task and assemble the full prompt the agent will see
  if [[ "$preview_prompt" == "true" ]]; then
    source "$RALPH_HOME/lib/ralph-gated-loop.sh"

    # Reuse the gated-loop callbacks (they define loop_init, loop_fetch_work, etc.)
    # We call ralph_gated_loop indirectly by sourcing it, which already defined the closures.
    # But we need to set up the same state the loop would.
    local _agent_key="$agent_key"
    local instance_num="$instance_num"

    ralph_load_provider

    local prompt_file provider_instructions
    prompt_file="$(ralph_get_prompt "$agent_key")"
    provider_instructions="$(ralph_get_provider_instructions)"

    # Fetch tasks from provider
    local _task_file="/tmp/ralph-${agent_key}-preview-task.json"
    local LOOP_WORK_FILE="/tmp/ralph-${agent_key}-preview-work.json"
    local query
    query="$(ralph_get_query "$agent_key")"
    provider_fetch_tasks "$query" 10 > "$LOOP_WORK_FILE"

    local task_count
    task_count=$(jq '.issues | length' "$LOOP_WORK_FILE")
    if (( task_count == 0 )); then
      echo "No tasks found for $agent_key (instance $instance_num). Nothing to preview."
      rm -f "$_task_file" "$LOOP_WORK_FILE"
      return
    fi

    # Pick task using same blocker-aware logic as the real loop
    local _exclude_blocked
    _exclude_blocked=$(jq -r ".agents.${agent_key}.rules.exclude_blocked // false" "$(ralph_get_routing_json)")
    local _blocker_check
    _blocker_check=$(jq -r ".agents.${agent_key}.rules.blocker_check // \"done\"" "$(ralph_get_routing_json)")

    # Blocker traversal helper (same as ralph-gated-loop.sh)
    _preview_traverse_blockers() {
      local issue_file="$1" mode="$2" q="$3" visited="$4"
      local blocker_keys
      blocker_keys=$(provider_get_unresolved_blocker_keys "$issue_file" "$mode")
      [[ -z "$blocker_keys" ]] && return 1
      local tmp_blocker tmp_result
      tmp_blocker=$(mktemp)
      for bk in ${=blocker_keys}; do
        [[ ":$visited:" == *":$bk:"* ]] && continue
        local base_q="${q%% ORDER BY *}"
        local bk_query="($base_q) AND key = \"$bk\""
        tmp_result=$(mktemp)
        provider_fetch_tasks "$bk_query" 1 > "$tmp_result"
        local mc
        mc=$(jq '.issues | length' "$tmp_result")
        if (( mc > 0 )); then
          jq '.issues[0]' "$tmp_result" > "$tmp_blocker"
          rm -f "$tmp_result"
          if ! provider_check_blockers "$tmp_blocker" "$mode"; then
            if _preview_traverse_blockers "$tmp_blocker" "$mode" "$q" "$visited:$bk"; then
              rm -f "$tmp_blocker"; return 0
            fi
          fi
          cp "$tmp_blocker" "$_task_file"
          rm -f "$tmp_blocker"; return 0
        fi
        rm -f "$tmp_result"
      done
      rm -f "$tmp_blocker"
      return 1
    }

    local unblocked_seen=0 pick_idx=0 found=false
    while (( pick_idx < task_count )); do
      jq ".issues[$pick_idx]" "$LOOP_WORK_FILE" > "$_task_file"
      if [[ "$_exclude_blocked" != "true" ]] || provider_check_blockers "$_task_file" "$_blocker_check"; then
        unblocked_seen=$((unblocked_seen + 1))
        if (( unblocked_seen == instance_num )); then
          found=true
          break
        fi
      else
        local bkey
        bkey=$(jq -r '.key' "$_task_file")
        if _preview_traverse_blockers "$_task_file" "$_blocker_check" "$query" "$bkey"; then
          unblocked_seen=$((unblocked_seen + 1))
          if (( unblocked_seen == instance_num )); then
            echo "Traversed blockers: $bkey → $(jq -r '.key' "$_task_file")"
            found=true
            break
          fi
        fi
      fi
      pick_idx=$((pick_idx + 1))
    done

    if [[ "$found" != "true" ]]; then
      echo "No unblocked task available for $agent_key instance $instance_num ($task_count tasks found, all blocked or claimed)."
      rm -f "$_task_file" "$LOOP_WORK_FILE"
      return
    fi

    local task_key
    task_key=$(jq -r '.key' "$_task_file")

    # Build the initial message (same as loop_build_context)
    local task_kb
    task_kb=$(provider_render_kb "$_task_file")
    local initial_message="You are RALPH_${(U)agent_key}, instance $instance_num. Your worktree is: (preview — no worktree) (project root: $(pwd)).

$task_kb

Execute your workflow now. Start with Step 1."

    echo "── ${agent_key} #${instance_num} preview — task $task_key ──"
    echo ""
    echo "======== SYSTEM PROMPT ========"
    cat "$prompt_file"
    echo ""
    if [[ -f "$provider_instructions" ]]; then
      cat "$provider_instructions"
    fi
    echo ""
    echo "======== INITIAL MESSAGE ========"
    echo "$initial_message"

    rm -f "$_task_file" "$LOOP_WORK_FILE"
    return
  fi

  ralph_get_jq_filters
  local stream_text="$RALPH_STREAM_FILTER"

  # --prompt mode: show the prompt log (plain text, no jq)
  if [[ "$prompt" == "true" ]]; then
    local prompt_log="/tmp/ralph-${agent_key}/${instance_num}/prompt.log"
    if [[ ! -f "$prompt_log" ]]; then
      echo "No prompt log found at $prompt_log"
      echo "The agent must complete at least one iteration to generate prompt.log."
      exit 1
    fi
    echo "── ${agent_key} #${instance_num} prompt ──"
    echo ""
    if [[ "$follow" == "true" ]]; then
      tail -f "$prompt_log"
    else
      tail -n "$lines" "$prompt_log"
    fi
    return
  fi

  # Try live session log first
  local session_log="/tmp/ralph-${agent_key}/${instance_num}/session.log"
  local log_file=""

  if [[ -f "$session_log" ]]; then
    log_file="$session_log"
  elif [[ -n "${RALPH_LOG_DIR:-}" ]]; then
    # Fallback: latest saved session log
    local log_dir="${RALPH_LOG_DIR%/}/${agent_key}-${instance_num}"
    if [[ -d "$log_dir" ]]; then
      log_file=$(ls -t "$log_dir"/*-session.log 2>/dev/null | head -1)
    fi
  fi

  if [[ -z "$log_file" ]]; then
    echo "No session log found for ${agent_key} #${instance_num}."
    echo ""
    echo "Checked:"
    echo "  Live:  $session_log"
    [[ -n "${RALPH_LOG_DIR:-}" ]] && echo "  Saved: ${RALPH_LOG_DIR%/}/${agent_key}-${instance_num}/"
    [[ -z "${RALPH_LOG_DIR:-}" ]] && echo "  Tip:   Set RALPH_LOG_DIR in .ralphrc to persist logs across sessions."
    exit 1
  fi

  local source_label="live"
  [[ "$log_file" != "$session_log" ]] && source_label="saved"
  echo "── ${agent_key} #${instance_num} ($source_label: $log_file) ──"
  echo ""

  _debug_render "$log_file" "$stream_text" "$follow" "$raw" "$lines"
}

_debug_render() {
  local log_file="$1" stream_text="$2" follow="$3" raw="$4" lines="$5"

  if [[ "$follow" == "true" ]]; then
    if [[ "$raw" == "true" ]]; then
      tail -f "$log_file"
    else
      tail -f "$log_file" \
        | grep --line-buffered '^{' \
        | jq --unbuffered -rj "$stream_text"
    fi
  else
    if [[ "$raw" == "true" ]]; then
      tail -n "$lines" "$log_file"
    else
      grep '^{' "$log_file" \
        | jq -rj "$stream_text" \
        | tail -n "$lines"
    fi
  fi
}

cmd_watchdog() {
  source "$RALPH_HOME/lib/ralph-watchdog.sh"

  local since="" agent="" apply=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --agent) agent="$2"; shift 2 ;;
      --apply) apply=true; shift ;;
      *)
        echo "Unknown option for watchdog: $1"
        echo "Usage: ralph watchdog [--since <dur>] [--agent <name>] [--apply]"
        exit 1
        ;;
    esac
  done

  local collect_args=()
  [[ -n "$since" ]] && collect_args+=(--since "$since")
  [[ -n "$agent" ]] && collect_args+=(--agent "$agent")

  ralph_watchdog_collect_logs "${collect_args[@]}" || exit 1
  ralph_watchdog_run || exit 1
  ralph_watchdog_save_report
  ralph_watchdog_print_patch

  if $apply; then
    ralph_watchdog_apply_patch "."
  fi
}

subcmd="${1:-}"
[[ -n "$subcmd" ]] && shift

case "$subcmd" in
  init)               cmd_init ;;
  config)             cmd_config ;;
  status)             cmd_status ;;
  cleanup)            cmd_cleanup "$@" ;;
  debug)              cmd_debug "$@" ;;
  version|-v)         cmd_version ;;
  help|--help|-h|"")  usage ;;
  run)                cmd_run "$@" ;;
  validate)           exec "$RALPH_HOME/bin/validate-routing-impl" "$@" ;;
  test)               cmd_test "$@" ;;
  watchdog)            cmd_watchdog "$@" ;;
  planner|implementer|reviewer|tester|refactor|documenter)
                      cmd_agent "$subcmd" "$@" ;;
  fixer|merger)       cmd_github_agent "$subcmd" "$@" ;;
  *)
    echo "Unknown command: $subcmd"
    echo "Run 'ralph help' for usage."
    exit 1
    ;;
esac
