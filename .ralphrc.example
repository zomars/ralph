# Backlog provider (jira, linear, file)
export RALPH_PROVIDER="jira"

# Model provider (claude, gemini, codex)
export RALPH_MODEL_PROVIDER="claude"

# Jira-specific (when RALPH_PROVIDER=jira)
export JIRA_EMAIL="you@example.com"
export JIRA_API_TOKEN="your-api-token"
export JIRA_BASE_URL="https://yourorg.atlassian.net"

# Linear-specific (when RALPH_PROVIDER=linear)
# export LINEAR_API_KEY="lin_api_xxxxx"
# export LINEAR_TEAM_KEY="ENG"

# File-specific (when RALPH_PROVIDER=file)
# export RALPH_PRD_FILE="./prd.md"  # Optional, defaults to ./prd.md

# Polling interval in seconds (default: 15)
export RALPH_POLL_INTERVAL=5

# Session log directory (unset = no logs saved)
# export RALPH_LOG_DIR="./ralph-logs"

# Project name — maps to ~/.ralph/projects/<name>/ for worktree overlay files.
# Defaults to basename of CWD (e.g. "frendor" when invoked from /Users/you/frendor).
# export RALPH_PROJECT="frendor"

# Worktree setup command — runs every agent start inside the worktree.
# Auto-detected: if unset and scripts/worktree-setup.sh exists, it runs automatically.
# export RALPH_WORKTREE_SETUP="bash scripts/worktree-setup.sh && npm install"

# Per-agent model override (haiku, sonnet, opus, or raw model ID)
# Built-in defaults: planner=opus, implementer/reviewer/tester/refactor/fixer=sonnet, documenter/merger=haiku
# export RALPH_MODEL="sonnet"            # global override for all agents
# export RALPH_PLANNER_MODEL="opus"      # override specific agent
# export RALPH_MERGER_MODEL="haiku"

# Merger agent settings
# export RALPH_MERGE_LABEL="ready-to-merge"  # Label that triggers merger (default: ready-to-merge)
