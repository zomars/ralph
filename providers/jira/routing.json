{
  "statuses": ["To Do", "In Progress", "In Review", "Done"],
  "pr_convention": {
    "description": "Draft PRs created by implementer. Reviewer undrafts on approval (Path C).",
    "created_by": "implementer→push (Section 5)",
    "created_as": "draft",
    "undrafted_by": "reviewer→approve (Path C)"
  },
  "labels": [
    "needs-planning",
    "needs-tests",
    "needs-staging-test",
    "staging-broken",
    "staging-verified",
    "staging-flake",
    "tech-debt",
    "ralph-blocked",
    "ralph-failed",
    "needs-input",
    "documented",
    "ready-to-merge",
    "code-approved"
  ],
  "global_label_excludes": ["needs-input"],
  "agents": {
    "planner": {
      "adds_labels": ["needs-input", "needs-tests"],
      "rules": {
        "status_in": ["To Do", "In Progress"],
        "labels_include": null,
        "labels_exclude": ["needs-input", "needs-tests", "needs-staging-test", "tech-debt", "ralph-blocked", "ralph-failed", "documented"],
        "description_condition": "empty_or_todo_or_label_needs_planning",
        "exclude_blocked": true,
        "blocker_check": "no_needs_planning",
        "order_by": "created_desc"
      },
      "script": "bin/afk-planner",
      "prompt": "prompts/planner.md"
    },
    "implementer": {
      "adds_labels": ["ralph-blocked", "needs-planning"],
      "rules": {
        "status_in": ["To Do", "In Progress"],
        "labels_include": null,
        "labels_exclude": ["needs-tests", "needs-staging-test", "tech-debt", "ralph-blocked", "needs-planning", "needs-input"],
        "description_condition": "not_empty_and_not_todo",
        "exclude_blocked": true,
        "skip_with_open_subtasks": true,
        "order_by": "priority_desc"
      },
      "script": "bin/afk-implementer",
      "prompt": "prompts/implementer.md"
    },
    "reviewer": {
      "adds_labels": ["ralph-failed", "needs-tests", "tech-debt", "ready-to-merge", "code-approved"],
      "rules": {
        "status_in": ["In Review"],
        "labels_include": null,
        "labels_exclude": ["needs-planning", "needs-tests", "needs-staging-test", "tech-debt", "needs-input", "ready-to-merge"],
        "description_condition": null,
        "exclude_blocked": false,
        "gate_label": "code-approved",
        "order_by": "priority_desc"
      },
      "script": "bin/afk-reviewer",
      "prompt": "prompts/reviewer.md"
    },
    "tester": {
      "adds_labels": ["tech-debt", "needs-planning"],
      "rules": {
        "status_in": ["To Do", "In Progress", "In Review"],
        "labels_include": ["needs-tests"],
        "labels_exclude": ["needs-planning", "needs-staging-test", "needs-input"],
        "description_condition": null,
        "order_by": "priority_desc"
      },
      "script": "bin/afk-tester",
      "prompt": "prompts/tester.md"
    },
    "refactor": {
      "adds_labels": [],
      "rules": {
        "status_in": ["To Do", "In Progress", "In Review", "Done"],
        "labels_include": ["tech-debt"],
        "labels_exclude": ["needs-planning", "needs-input", "needs-tests", "needs-staging-test"],
        "description_condition": null,
        "order_by": "priority_desc"
      },
      "script": "bin/afk-refactor",
      "prompt": "prompts/refactor.md"
    },
    "documenter": {
      "adds_labels": ["documented"],
      "rules": {
        "status_in": ["Done"],
        "labels_include": null,
        "labels_exclude": ["documented", "tech-debt", "needs-input", "needs-staging-test"],
        "description_condition": null,
        "order_by": "updated_desc"
      },
      "script": "bin/afk-documenter",
      "prompt": "prompts/documenter.md"
    },
    "verifier": {
      "adds_labels": ["staging-broken", "staging-verified", "staging-flake"],
      "rules": {
        "status_in": ["To Do", "In Progress", "In Review", "Done"],
        "labels_include": ["needs-staging-test"],
        "labels_exclude": ["staging-broken", "staging-verified", "staging-flake", "needs-input"],
        "description_condition": null,
        "uses_worktree": false,
        "order_by": "priority_desc"
      },
      "script": "bin/afk-verifier",
      "prompt": "prompts/verifier.md"
    }
  }
}
